{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": ["cdg1"],
  "env": {
    "NODE_ENV": "production"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/diploma-expiry-alerts",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/send-jury-convocations",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/send-scheduled-documents",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/notification-reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/send-notifications",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/affiliate-followup-j7",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/compliance-alerts",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/emails/scheduled/execute",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/auto-launch-attendance",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/onboarding-activation",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/onboarding-reengagement",
      "schedule": "0 10 * * *"
    }
  ],
  "functions": {
    "app/api/jury/send-convocation/route.ts": {
      "maxDuration": 30
    },
    "app/api/documents/generate-pdf/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "app/api/webhooks/stripe/route.ts": {
      "maxDuration": 30
    },
    "app/api/subscriptions/webhook/route.ts": {
      "maxDuration": 30
    }
  }
}
