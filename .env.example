# =======================
# EDUZEN - Environment Variables Template
# =======================
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to version control

# =======================
# Supabase Configuration
# =======================
# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_PROJECT_ID=your_project_id_here

# =======================
# App Configuration
# =======================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=eduzen

# =======================
# Storage
# =======================
NEXT_PUBLIC_STORAGE_BUCKET=eduzen-documents

# =======================
# Email Service (Resend)
# =======================
# Sign up at: https://resend.com
# Documentation: https://resend.com/docs
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=noreply@yourdomain.com
SUPPORT_EMAIL=support@yourdomain.com

# =======================
# Feature Flags
# =======================
NEXT_PUBLIC_ENABLE_MOBILE_MONEY=true
NEXT_PUBLIC_ENABLE_OFFLINE_MODE=true

# =======================
# Error Tracking (Optional)
# =======================
# Sign up at: https://sentry.io
# Monitoring production : définir NEXT_PUBLIC_SENTRY_DSN pour activer Sentry (recommandé en prod)
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project-id

# =======================
# Security
# =======================
# CSRF token signing secret (required in production)
# Generate with: openssl rand -base64 32
CSRF_SECRET=your_csrf_secret_here

# Allowed origins for CORS (comma-separated) — REQUIRED in production
ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# =======================
# Logging
# =======================
# Set to 'debug', 'info', 'warn', or 'error'
LOG_LEVEL=info
ENABLE_CONSOLE_LOGS=false

# =======================
# Stripe (Paiements & Abonnements)
# =======================
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
# Webhook signing secret (Stripe CLI: stripe listen --forward-to localhost:3000/api/subscriptions/webhook)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# =======================
# Rate Limiting (Upstash Redis)
# =======================
# Dashboard: https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# =======================
# Email (SendGrid - optionnel, Resend utilisé par défaut)
# =======================
# Si vous utilisez SendGrid au lieu de Resend
# SENDGRID_API_KEY=SG.your_api_key_here
# SENDGRID_FROM_EMAIL=noreply@yourdomain.com
# NEXT_PUBLIC_EMAIL_PROVIDER=sendgrid

# =======================
# Signatures électroniques
# =======================
# Secret pour sécuriser les preuves de signature (générer avec: openssl rand -base64 32)
SIGNATURE_EVIDENCE_SECRET=your_secret_here
# Clé API YouSign (si module e-signature activé)
# YOUSIGN_API_KEY=your_yousign_api_key_here
# Secret de vérification des webhooks e-signature
# ESIGNATURE_WEBHOOK_SECRET=your_esignature_webhook_secret_here

# =======================
# Cron / Tâches planifiées
# =======================
# Secret pour sécuriser l'exécution des emails planifiés (ex: Vercel Cron)
CRON_SECRET=your_cron_secret_here
# IPs autorisées pour les routes cron (optionnel, comma-separated)
# CRON_ALLOWED_IPS=35.158.136.76,35.158.136.77

# =======================
# APIs externes
# =======================
# API Sirene (données entreprises françaises)
# SIRENE_API_KEY=your_sirene_api_key_here
# Slack (notifications internes)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
# Emails admins (comma-separated)
# ADMIN_EMAILS=admin@yourdomain.com

# =======================
# Chiffrement (Templates)
# =======================
# Clé de chiffrement des templates (générer avec: openssl rand -hex 32)
# TEMPLATE_ENCRYPTION_KEY=your_64_char_hex_key_here

# =======================
# PDF Generation (Gotenberg)
# =======================
# Gotenberg est le moteur PDF principal (Puppeteer est le fallback).
# Déployer Gotenberg sur Railway/Render/Fly.io : docker pull gotenberg/gotenberg:8
# Si non configuré, la génération bascule automatiquement sur Puppeteer.
GOTENBERG_URL=https://your-gotenberg-instance.railway.app
# Optionnel — protection de l'instance Gotenberg
# GOTENBERG_API_KEY=your_api_key_here
# GOTENBERG_BASIC_AUTH=user:password
